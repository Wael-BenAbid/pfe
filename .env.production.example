# Configuration pour la production
# Copiez ce fichier en .env.production et remplissez les valeurs.
# Ne commitez JAMAIS le fichier .env.production.

COMPOSE_MODE=production
FRONTEND_IMAGE=waelbenabid/rh-frontend:latest
BACKEND_IMAGE=waelbenabid/rh-system-backend:latest

FRONTEND_PORT=5175
FRONTEND_INTERNAL_PORT=80
BACKEND_PORT=8000
DB_PORT=5433

NODE_ENV=production
VITE_API_BASE_URL=http://backend:8000
VITE_ZIPKIN_URL=http://localhost:9411
VITE_ZIPKIN_ENABLED=true

DEBUG=False
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changez-moi
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=User

DATABASE_NAME=rh_v2
DATABASE_USER=postgres
DATABASE_PASSWORD=changez-moi
DATABASE_HOST=db
DATABASE_PORT=5432
POSTGRES_DB=rh_v2
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changez-moi

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_PROVIDER=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=votre-email@gmail.com
EMAIL_HOST_PASSWORD=votre-mot-de-passe-application
DEFAULT_FROM_EMAIL=RH System <votre-email@gmail.com>

ZIPKIN_ENABLED=True
ZIPKIN_SERVER_URL=http://zipkin:9411
ZIPKIN_SERVICE_NAME=rh-backend
ZIPKIN_SAMPLE_RATE=100.0

FRONTEND_URL=http://localhost:5175
