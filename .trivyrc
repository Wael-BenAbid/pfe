# Configuration Trivy
# Ce fichier est utilisé par Trivy pour configurer les scans de sécurité

# Ignorer les vulnérabilités non corrigées
ignore-unfixed: true

# Sévérités à scanner
severity: CRITICAL,HIGH

# Timeout pour les scans
timeout: 10m

# Répertoires à ignorer
skip-dirs:
  - .git
  - .github
  - node_modules
  - __pycache__

# Fichiers à ignorer
skip-files:
  - "*.md"
  - "*.txt"
  - "*.json"
  - "*.lock"
  - "*.log"

# Format de sortie
format: table

# Ne pas afficher la barre de progression
no-progress: true
