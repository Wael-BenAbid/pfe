{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "python",
        "name": "Django Server",
        "request": "launch",
        "program": "${workspaceFolder}/back-end/manage.py",
        "args": [
          "runserver",
          "8000"
        ],
        "django": true
      },
      {
        "type": "pwa-msedge",
        "name": "Launch Microsoft Edge",
        "request": "launch",
        "runtimeArgs": [
          "--remote-debugging-port=9222"
        ],
        "url": "http://localhost:8000", 
        "presentation": {
          "hidden": false
        }
      },
      {
        "type": "pwa-msedge",
        "name": "Launch Microsoft Edge in headless mode",
        "request": "launch",
        "runtimeArgs": [
          "--headless",
          "--remote-debugging-port=9222"
        ],
        "url": "http://localhost:8000",
        "presentation": {
          "hidden": false
        }
      },
      {
        "type": "vscode-edge-devtools.debug",
        "name": "Open Edge DevTools",
        "request": "attach",
        "url": "http://localhost:8000",
        "presentation": {
          "hidden": false
        }
      }
    ],
    "compounds": [
      {
        "name": "Launch Edge Headless and attach DevTools",
        "configurations": [
          "Launch Microsoft Edge in headless mode",
          "Open Edge DevTools"
        ]
      },
      {
        "name": "Launch Edge and attach DevTools",
        "configurations": [
          "Launch Microsoft Edge",
          "Open Edge DevTools"
        ]
      }
    ]
  }
  