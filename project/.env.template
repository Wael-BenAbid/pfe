# Ce fichier est un modèle pour le fichier .env du frontend
# Copiez ce fichier vers .env et remplissez les valeurs appropriées
# IMPORTANT: Ne commettez jamais votre fichier .env réel dans Git

# URL de base de l'API (sans préfixe /api)
VITE_API_BASE_URL=http://localhost:8000

# Configuration Zipkin
# Pour Docker: /zipkin (utilise le proxy nginx)
# Pour Local: http://localhost:9411 (accès direct)
VITE_ZIPKIN_URL=/zipkin
VITE_ZIPKIN_ENABLED=true
